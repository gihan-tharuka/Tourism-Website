# Docker compose defaults for local development.
# Copy values into your shell environment or a local .env file if needed.
# Do not commit real production secrets.

NEXT_PUBLIC_API_URL=http://localhost:5001/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=

# backend/.env is used by docker-compose.yml for the backend service.
# Required backend variables:
# DATABASE_URL=
# DIRECT_URL=
# JWT_SECRET=
# JWT_EXPIRES_IN=7d
# FRONTEND_URL=http://localhost:3000
# PORT=5001

# Optional local PostgreSQL values for docker-compose.local-db.yml:
POSTGRES_DB=beyond_sea_travels
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
